# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/todo

# GitHub OAuth App credentials (see docs/AUTH.md). Never commit the real secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public origin of this app, used to build the OAuth callback URL.
# Must match the "Authorization callback URL" of the GitHub OAuth App (origin + /auth/github/callback).
APP_URL=http://localhost:3000
